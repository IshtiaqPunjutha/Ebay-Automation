{
  "manifest_version": 3,
  "name": "AliExpress Sync for Order Dashboard",
  "version": "1.3.0",
  "description": "Sends your AliExpress order numbers to your eBay order dashboard.",
  "permissions": ["storage", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "AliExpress Sync", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["*://*.aliexpress.com/*", "*://*.aliexpress.us/*"],
      "js": ["lib.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
