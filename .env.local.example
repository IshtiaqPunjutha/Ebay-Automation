# --- App login (Step 1: simple shared password gate) ---
APP_PASSWORD=test@123

# --- Session secret (any long random string) ---
SESSION_SECRET=replace-with-a-long-random-string

# --- eBay Developer App credentials ---
# Get these from developer.ebay.com -> My Account -> Application Keys
EBAY_CLIENT_ID=your-ebay-client-id
EBAY_CLIENT_SECRET=your-ebay-client-secret
# The "RuName" you configured in your eBay app (this is NOT a real URL,
# it's an identifier string eBay gives you that maps to your redirect URI)
EBAY_RUNAME=your-ebay-runame

# sandbox = for testing with fake orders, production = your real live store
EBAY_ENV=sandbox

# Your deployed app's base URL (Vercel gives you this after first deploy)
# Example: https://your-app-name.vercel.app
APP_BASE_URL=http://localhost:3000

# --- Vercel KV (free tier) — used to store OAuth tokens ---
# Create this in your Vercel project dashboard: Storage -> Create Database -> KV
# Vercel auto-fills these into your project env vars when you connect it,
# but list them here too for local dev.
KV_REST_API_URL=
KV_REST_API_TOKEN=
