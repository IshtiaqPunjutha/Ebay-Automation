# --- Session signing secret (at least 32 random characters) ---
SESSION_SECRET=replace-with-a-long-random-string

# Keep the old shared password temporarily to claim stores from the previous
# dashboard during the first account signup. Remove it after migration.
APP_PASSWORD=

# --- eBay Developer App credentials ---
# Get these from developer.ebay.com -> My Account -> Application Keys
EBAY_CLIENT_ID=your-ebay-client-id
EBAY_CLIENT_SECRET=your-ebay-client-secret
# The "RuName" you configured in your eBay app (this is NOT a real URL,
# it's an identifier string eBay gives you that maps to your redirect URI)
EBAY_RUNAME=your-ebay-runame

# Required for Finances API requests made for UK/EU sellers.
# Create an ED25519 signing key through eBay's Key Management API.
EBAY_SIGNATURE_KEY_JWE=your-ebay-signing-key-jwe
EBAY_SIGNATURE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nreplace-with-private-key\\n-----END PRIVATE KEY-----"

# eBay production environment (live store)
EBAY_ENV=production

# Optional: site to pull product images from; defaults to EBAY_GB.
# Common values: EBAY_GB, EBAY_US, EBAY_DE, EBAY_AU.
EBAY_MARKETPLACE_ID=EBAY_GB

# Your deployed app's base URL (Vercel gives you this after first deploy)
# Example: https://your-app-name.vercel.app
APP_BASE_URL=http://localhost:3000

# --- Vercel KV (free tier) — used to store OAuth tokens ---
# Create this in your Vercel project dashboard: Storage -> Create Database -> KV
# Vercel auto-fills these into your project env vars when you connect it,
# but list them here too for local dev.
KV_REST_API_URL=
KV_REST_API_TOKEN=
